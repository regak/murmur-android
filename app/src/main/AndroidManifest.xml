<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Murmur"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Murmur">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 1: foreground service hosting the overlay bubble + mic capture
             while recording. Added once DictationController exists. -->

        <!-- Phase 2: custom keyboard (IME), primary text-injection path.
             Enabled by the user under Settings, System, Languages and input,
             On-screen keyboard, Manage keyboards, then switched to from any
             text field's keyboard-switcher (globe icon / long-press space). -->
        <service
            android:name=".ime.MurmurInputMethodService"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Phase 2 item 8: fallback/general-purpose text injector for the
             floating bubble, which has no InputConnection of its own (it is
             not a keyboard). User must enable this manually under Settings,
             Accessibility, Murmur. Android does not allow a service to
             enable Accessibility for itself, by design, to prevent abuse. -->
        <service
            android:name=".inject.MurmurAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- The "hanging button": a draggable floating mic that stays on top
             of every other app, press-and-hold to dictate, matching Wispr
             Flow's floating-button interaction. Foreground service so it
             survives the user leaving Murmur for another app. -->
        <service
            android:name=".overlay.FloatingBubbleService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>
